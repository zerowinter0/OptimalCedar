# Copy to evaluation/chapter6_experiments/experiments.env or pass
# CH6_ENV=/path/to/this-file when running scripts.

# Result root. Each script writes raw JSON/CSV, logs, generated profiles, and
# summaries under this directory.
CH6_OUT_DIR=/tmp/pico_chapter6_results

# Main workload set. Start with one workload for smoke tests, then expand.
# Available: bloom_oscar llava_pretrain wikitext103 simclrv2 commonvoice coco
CH6_WORKLOADS="bloom_oscar llava_pretrain"

# Optimizers used by plan-quality/runtime scripts.
# optimizer: original Cedar staged optimizer.py
# dp_cedar_optimizer: Cedar staged optimizer with DP reorder only
# dp_seperate_optimizer: two-stage DP, reorder first then physical choices
# dp_optimizer: PICO unified DP
CH6_OPTIMIZERS="optimizer dp_cedar_optimizer dp_seperate_optimizer dp_optimizer"

# Repeats and sample caps. CH6_DATA_NUM_TOTAL_SAMPLES bounds runtime during
# comparison unless CH6_FULL_DATA_RUN=1.
CH6_REPEATS=3
CH6_NUM_EPOCHS=1
CH6_NUM_TOTAL_SAMPLES=10000
CH6_DATA_NUM_TOTAL_SAMPLES=1000
CH6_PROFILE_SAMPLES=200
CH6_FULL_DATA_RUN=0

# Distributed execution. Set CH6_RAY_IP to a running Ray head when using a
# remote cluster. Leave empty to let Cedar/Ray use local Ray.
CH6_USE_RAY=1
CH6_RAY_IP=
CH6_DISABLE_OFFLOAD=0
CH6_ENABLE_LOCAL_PARALLELISM=1
CH6_DISABLE_CACHING=0

# Runtime hygiene.
CH6_ALLOW_TORCH_PARALLELISM=0
CH6_LOG_LEVEL=INFO
CH6_HOME=/tmp

# Data-Juicer text workload.
BLOOM_DATASET_PATH=/tmp/redpajama_backup_3gb_for_bloom_oscar.jsonl
BLOOM_PROFILE_PATH=/tmp/pico_chapter6_profiles/bloom_oscar_profile.yml
BLOOM_NUM_TOTAL_SAMPLES=10000

# Data-Juicer image-text workload.
LLAVA_DATASET_PATH=/tmp/llava_pretrain_cedar_fixture.jsonl
LLAVA_IMAGE_ROOT=/tmp/llava_pretrain_cedar_images
LLAVA_PROFILE_PATH=/tmp/pico_chapter6_profiles/llava_pretrain_profile.yml
LLAVA_NUM_TOTAL_SAMPLES=1000

# Existing Cedar workloads may reuse repository profiles by default. Override
# these paths if you reprofile on the server.
# WIKITEXT_PROFILE_PATH=evaluation/pipelines/wikitext103/stats/cedar.yaml
# SIMCLR_PROFILE_PATH=evaluation/pipelines/simclrv2/stats/cedar_stats.yaml
# COMMONVOICE_PROFILE_PATH=evaluation/pipelines/commonvoice/stats/cedar.yaml
# COCO_PROFILE_PATH=evaluation/pipelines/coco/stats/coco_local_stats.yaml

# Optional long-tail experiments.
CH6_RUN_PROFILE_SENSITIVITY=0
CH6_PROFILE_SAMPLE_SWEEP="20 50 100 200"
CH6_CACHE_EPOCHS=3
CH6_ABLATION_CONDITIONS="full_dp stagewise_dp no_reorder no_fusion no_offload no_cache no_parallelism"
